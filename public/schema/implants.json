          "@type": "Question",
          "name": "Are dental implants painful?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Performed under local anaesthesia or sedation; mild soreness fades in 2–3 days."
          }
        },
        {
          "@type": "Question",
          "name": "How long do dental implants last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With proper hygiene and reviews, over 95 % last beyond 15 years."
          }
        },
        {
          "@type": "Question",
          "name": "Can diabetics get implants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — if HbA1c ≤ 7.5 and physician clearance obtained before surgery."
          }
        },
        {
          "@type": "Question",
          "name": "Is CBCT scan mandatory?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. 3D CBCT enables safe, precise, nerve-avoiding implant planning."
          }
        },
        {
          "@type": "Question",
          "name": "Do implants need special cleaning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Brush twice daily, floss gently, and get professional cleanings every 6–12 months."
          }
        }
