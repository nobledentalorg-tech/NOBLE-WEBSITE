# ==============================
# Noble Dental Case Manager – ENV Example
# ==============================

# Database
DB_HOST=localhost
DB_NAME=dental_case_manager
DB_USER=root
DB_PASS=

# App
APP_NAME="Noble Dental Care"
APP_URL="https://nobledentalnallagandla.in"
APP_TIMEZONE="Asia/Kolkata"
APP_ENV=production

# Security
JWT_SECRET=NDCaseManagerJWT2025
VERIFY_SECRET=NDCaseManager2025

# Mail (future)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=youremail@gmail.com
MAIL_PASS=yourpassword
MAIL_FROM="Noble Dental Care <no-reply@nobledentalnallagandla.in>"
